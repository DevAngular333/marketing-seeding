SEEDING_HOST=127.0.0.1
SEEDING_PORT=4318
# Optional local fixture worker; remains disabled unless explicitly set to 1.
SEEDING_FIXTURE_WORKER=0
SEEDING_FIXTURE_WORKER_INTERVAL_MS=60000
# Path to the local fixture adapter package used by the dry-run bridge.
# MARKETING_FIXTURE_ROOT=<local fixture adapter path>
# Optional local CloakBrowser CDP endpoint. Never store credentials or cookies here.
CLOAKBROWSER_CDP_URL=
SEEDING_FIXTURE_CDP_ENABLED=0
# Read-only E2E DOM/network probe; never clicks or publishes.
SEEDING_FIXTURE_E2E_LIVE=0
# Runtime data defaults to %AGENTIC_ROOT%\.agentic\marketing-seeding.
# AGENTIC_ROOT=<local control-plane folder>
# SEEDING_DATA_DIR=<private local state folder>
# SEEDING_AUTO_GTM_FEED_FILE=<local Auto-GTM JSON feed>
